---
// El cerebro sináptico de la web anterior, copiado íntegro (gerencia, 14/11/2026): la misma imagen
// (public/imagenes/cerebro-synentor.png, sha256 a7579119…d825, la de src/assets/brain-logo.png del ERP), los tres halos
// que laten, el resplandor violeta y azul, la máscara redonda, la sombra de la imagen y las diez chispas, con los mismos
// valores que RRHHPulsingBrain.tsx. Lo único añadido: con «reducir movimiento», todo quieto (halos por marca.css, chispas
// con pauseAnimations). Decorativo para los lectores de pantalla.
interface Props {
  /** Identificador del filtro de las chispas: único en la página. */
  id?: string;
  clase?: string;
}
const { id = 'cerebro', clase = '' } = Astro.props;
const filtro = `${id}-chispa`;
const chispas = [
  { cx: 30, cy: 25, delay: 0, duration: 1.5 },
  { cx: 45, cy: 18, delay: 0.3, duration: 1.2 },
  { cx: 60, cy: 22, delay: 0.6, duration: 1.4 },
  { cx: 70, cy: 30, delay: 0.9, duration: 1.3 },
  { cx: 55, cy: 35, delay: 0.2, duration: 1.5 },
  { cx: 35, cy: 40, delay: 0.5, duration: 1.1 },
  { cx: 50, cy: 45, delay: 0.8, duration: 1.4 },
  { cx: 65, cy: 42, delay: 0.1, duration: 1.2 },
  { cx: 25, cy: 35, delay: 0.4, duration: 1.6 },
  { cx: 75, cy: 38, delay: 0.7, duration: 1.3 },
];
---

<span class={`cerebro ${clase}`.trim()} aria-hidden="true">
  <span class="cb-halo cb-halo-1"></span>
  <span class="cb-halo cb-halo-2"></span>
  <span class="cb-halo cb-halo-3"></span>
  <span class="cb-circulo">
    <span class="cb-resplandor"></span>
    <span class="cb-mascara">
      <picture>
        <source srcset="/imagenes/cerebro-synentor.webp" type="image/webp" />
        <img src="/imagenes/cerebro-synentor.png" alt="" width="770" height="578" loading="eager" decoding="async" />
      </picture>
    </span>
    <svg class="cb-chispas" viewBox="0 0 100 80">
      <defs>
        <filter id={filtro} x="-400%" y="-400%" width="900%" height="900%">
          <feGaussianBlur stdDeviation="2" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
      {
        chispas.map((c) => (
          <g filter={`url(#${filtro})`}>
            <circle cx={c.cx} cy={c.cy} r="1" style="fill:var(--syn-blanco)">
              <animate attributeName="opacity" values="0.2;0.2;1;1;0.2;0.2" dur={`${c.duration}s`} begin={`${c.delay}s`} repeatCount="indefinite" />
              <animate attributeName="r" values="0.8;0.8;2;1.5;1;0.8" dur={`${c.duration}s`} begin={`${c.delay}s`} repeatCount="indefinite" />
            </circle>
          </g>
        ))
      }
    </svg>
  </span>
</span>

<script>
  // Las chispas son animaciones del propio SVG (no las para el CSS): con «reducir movimiento», se paran aquí.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('svg.cb-chispas').forEach((s) => s.pauseAnimations());
  }
</script>
