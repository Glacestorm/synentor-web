---
// Portada (diseño §8): una idea por bloque, frases cortas, contraste azul noche y dorado. Los precios, de la tarifa.
import { textos, rellena } from '../../i18n/t';
import { ruta, type Idioma } from '../../i18n/idiomas';
import { TARIFA } from '../../lib/precios/tarifa';
import { euros } from '../../lib/formato';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const tx = textos(idioma).inicio;
const eur = (n: number) => euros(n, idioma);
const contacto = ruta('contacto', idioma);
const servicios = ruta('servicios', idioma);
const precios = ruta('precios', idioma);
---

<section class="portada">
  <div class="contenedor portada-dentro">
    <p class="antetitulo">{tx.portada.antetitulo}</p>
    <h1><span class="texto-oro">{tx.portada.titulo}</span></h1>
    <p class="subtitulo">{tx.portada.subtitulo}</p>
    <div class="botones">
      <a class="boton boton-oro" href={`${contacto}?asunto=demostracion`}>{tx.portada.botonDemo}</a>
      <a class="boton boton-contorno" href={precios}>{tx.portada.botonPrecio}</a>
    </div>
    <p class="nota">{rellena(tx.portada.nota, { base: eur(TARIFA.base.cuota), usuarios: TARIFA.base.usuariosIncluidos })}</p>
  </div>
  <div class="halo" aria-hidden="true"></div>
</section>

<section class="bloque">
  <div class="contenedor estrecho">
    <h2>{tx.problema.titulo}</h2>
    <ul class="lista-x">{tx.problema.puntos.map((p) => <li>{p}</li>)}</ul>
    <p class="cierre">{tx.problema.cierre}</p>
  </div>
</section>

<section class="bloque claro">
  <div class="contenedor">
    <h2>{tx.pilares.titulo}</h2>
    <div class="rejilla-3">
      {
        (['suite', 'muv', 'consultoria'] as const).map((k) => (
          <article class="tarjeta">
            <h3>{tx.pilares[k].titulo}</h3>
            <p>{tx.pilares[k].texto}</p>
            <a class="enlace" href={`${servicios}#${k}`}>{tx.pilares.mas} →</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="bloque">
  <div class="contenedor dos-col">
    <div>
      <p class="antetitulo">{tx.rrhh.antetitulo}</p>
      <h2>{tx.rrhh.titulo}</h2>
      <p>{tx.rrhh.texto}</p>
      <p class="destacado">{tx.rrhh.dato}</p>
    </div>
    <div>
      <ul class="lista-ok">{tx.rrhh.puntos.map((p) => <li>{p}</li>)}</ul>
      <p class="pequeno">{tx.rrhh.espana}</p>
    </div>
  </div>
</section>

<section class="bloque claro">
  <div class="contenedor dos-col">
    <div>
      <p class="antetitulo">{tx.multiempresa.antetitulo}</p>
      <h2>{tx.multiempresa.titulo}</h2>
      <p>{tx.multiempresa.texto}</p>
    </div>
    <ul class="lista-ok">
      {
        tx.multiempresa.puntos.map((p) => (
          <li>{rellena(p, { usuarios: TARIFA.base.usuariosIncluidos, empresaAdicional: eur(TARIFA.empresaAdicional.cuota) })}</li>
        ))
      }
    </ul>
  </div>
</section>

<section class="bloque">
  <div class="contenedor estrecho centrado">
    <p class="antetitulo">{tx.ia.antetitulo}</p>
    <h2><span class="texto-oro">{tx.ia.titulo}</span></h2>
    <p>{tx.ia.texto}</p>
  </div>
</section>

<section class="bloque claro">
  <div class="contenedor rejilla-3">
    {
      (['compras', 'bancos', 'juridico'] as const).map((k) => (
        <article class="tarjeta">
          <h3>{tx[k].titulo}</h3>
          <p>{tx[k].texto}</p>
        </article>
      ))
    }
  </div>
</section>

<section class="bloque">
  <div class="contenedor estrecho">
    <p class="antetitulo">{tx.historia.antetitulo}</p>
    <h2>{tx.historia.titulo}</h2>
    <p>{tx.historia.texto}</p>
  </div>
</section>

<section class="bloque claro">
  <div class="contenedor estrecho centrado">
    <h2>{tx.precio.titulo}</h2>
    <p>{tx.precio.texto}</p>
    <p class="precio-grande">{rellena(tx.portada.nota, { base: eur(TARIFA.base.cuota), usuarios: TARIFA.base.usuariosIncluidos })}</p>
    <a class="boton boton-oro" href={precios}>{tx.precio.boton}</a>
  </div>
</section>

<section class="bloque final">
  <div class="contenedor estrecho centrado">
    <h2><span class="texto-oro">{tx.final.titulo}</span></h2>
    <p>{tx.final.texto}</p>
    <a class="boton boton-oro" href={`${contacto}?asunto=demostracion`}>{tx.final.boton}</a>
  </div>
</section>
