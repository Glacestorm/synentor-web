{
  "name": "synentor-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Web pública de Synentor (Astro estático servido por Cloudflare Workers).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "test": "vitest run",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "revision-legal": "esbuild scripts/revision-legal.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/revision-legal.mjs && node node_modules/.cache/revision-legal.mjs",
    "articulos-erp": "esbuild scripts/articulos-erp.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/articulos-erp.mjs && node node_modules/.cache/articulos-erp.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/node": "22.20.5",
    "astro": "5.18.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0"
  }
}
